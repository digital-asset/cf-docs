use_flake_subdir() {
  # Keep direnv's cache in sync with every tracked Nix input.
  for file in $(git ls-files nix); do
    watch_file "$file"
  done
  mkdir -p "$(direnv_layout_dir)"
  eval "$(nix --extra-experimental-features "nix-command flakes" print-dev-env \
    --profile "$(direnv_layout_dir)/flake-profile" "path:nix" "$@")"
}

# Preserve the caller's TMPDIR state because Nix development shells may replace
# it with a temporary directory path that no longer exists after activation.
old_tmpdir="${TMPDIR-}"
old_tmpdir_was_set="${TMPDIR+x}"

use flake_subdir

if [ -n "${old_tmpdir_was_set}" ]; then
  export TMPDIR="$old_tmpdir"
else
  unset TMPDIR
fi
